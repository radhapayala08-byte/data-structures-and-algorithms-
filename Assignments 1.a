#include <stdio.h>
int main()
{
    int a[10], n, key, i;
    int low, high, mid;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    printf("Enter sorted elements:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("Enter roll number to search: ");
    scanf("%d", &key);
    for(i = 0; i < n; i++)
    {
        if(a[i] == key)
        {
            printf("Sequential Search: Found at position %d\n", i + 1);
            break;
        }
    }
    if(i == n)
        printf("Sequential Search: Not Found\n");
    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = (low + high) / 2;
        if(a[mid] == key)
        {
            printf("Binary Search: Found at position %d\n", mid + 1);
            return 0;
        }
        else if(key < a[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }
    printf("Binary Search: Not Found\n");
}
