#include <stdio.h>
#define N 6
int main()
{
    int matrix[N][N] = {0};
    int i;
    matrix[0][1] = 1;
    matrix[1][0] = 1;
    matrix[0][2] = 1;
    matrix[2][0] = 1;
    matrix[1][3] = 1;
    matrix[3][1] = 1;
    matrix[2][3] = 1;
    matrix[3][2] = 1;
    matrix[3][4] = 1;
    matrix[4][3] = 1;
    matrix[4][5] = 1;
    matrix[5][4] = 1;
    printf("Adjacency Matrix:\n");
    for (i = 0; i < N; i++)
    {
        for (int j = 0; j < N; j++)
        {
            printf("%d ", matrix[i][j]);
        }
        printf("\n");
    }
}
