#include <stdio.h>
#include <ctype.h>
char stack[50];
int top=-1;
void push(char x)
{
    stack[++top]=x;
}
char pop()
{
    return stack[top--];
}
int priority(char x)
{
    if(x=='+' || x=='-')
        return 1;
    if(x=='*' || x=='/')
        return 2;
    return 0;
}
int main()
{
    char exp[50], ch;
    int i;
    printf("Enter infix expression: ");
    scanf("%s", exp);
    printf("Postfix expression: ");
    for(i = 0;exp[i] !='\0';i++)
    {
        ch=exp[i];
        if(isalnum(ch))
            printf("%c",ch);
        else if(ch=='(')
            push(ch);
        else if(ch==')')
        {
            while(stack[top]!='(')
                printf("%c",pop());
            pop();
        }
        else
        {
            while(top != -1 && priority(stack[top]) >= priority(ch))
                printf("%c", pop());
            push(ch);
        }
    }
    while(top != -1)
        printf("%c", pop());
}
